# Copy to backend/.env. Never put these values in frontend/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLASSROOM_MCP_URL=https://classroommcp.googleapis.com/mcp/v1
GOOGLE_DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1
# OAuth token from a trusted MCP OAuth client. Do not commit or log it.
GOOGLE_MCP_ACCESS_TOKEN=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_MB=15
# SQLite database path defaults to ../data/scholarflow.sqlite3 from the backend folder.
# DATABASE_PATH=../data/scholarflow.sqlite3
